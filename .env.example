# ==============================================================================
# SMS Management Platform - Environment Configuration Blueprint
# ==============================================================================

# Server Environment
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# PostgreSQL / Prisma Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_platform?schema=public"

# Security & Authentication
# Secure random string used to sign session tokens and JWTs
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Optional Seed Credentials (Phase 03 development)
SEED_ADMIN_EMAIL="admin@smshub.local"
SEED_ADMIN_PASSWORD="Admin#Secure2026!"
SEED_MANAGER_EMAIL="manager@smshub.local"
SEED_MANAGER_PASSWORD="Manager#Secure2026!"
SEED_AGENT_EMAIL="agent@smshub.local"
SEED_AGENT_PASSWORD="Agent#Secure2026!"
SEED_CLIENT_EMAIL="client@smshub.local"
SEED_CLIENT_PASSWORD="Client#Secure2026!"

# Optional AI / Service Integrations (managed via AI Studio Secrets)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
