// Prisma schema - approved final architecture (corrected pass 2)
// ONE datasource, ONE generator, ONE definition per model/enum

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum ProviderConnectionType {
  HTTP
  SMPP
  OTHER
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InboundStatus {
  RECEIVED
  PROCESSING
  ROUTED
  UNROUTED
  FAILED
}

enum BillingStatus {
  PENDING
  BILLED
  ERROR
}

enum RateType {
  INBOUND
  OUTBOUND
  DELIVERY_REPORT
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  FEE
}

enum LedgerSourceType {
  RATE
  BILLING_EVENT
  CREDIT_NOTE
  PAYMENT_REQUEST
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ALERT
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  managerProfiles     ManagerProfile[]
  agents              Agent[]
  clients             Client[]
  providers           Provider[]
  ranges              Range[]
  numbers             Number[]
  activeAssignments   ActiveAssignment[]
  assignmentHistories AssignmentHistory[]
  inboundMessages     InboundMessage[]
  cdrs                Cdr[]
  billingEvents       BillingEvent[]
  rates               Rate[]
  wallets             Wallet[]
  ledgerEntries       LedgerEntry[]
  billingTransactions BillingTransaction[]
  creditNotes         CreditNote[]
  paymentRequests     PaymentRequest[]
  notifications       Notification[]
  apiCredentials      ApiCredential[]
  apiRequestLogs      ApiRequestLog[]
  auditLogs           AuditLog[]
}

// ============================================================
// RBAC
// ============================================================

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String?
  status         String   @default("ACTIVE")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // RBAC
  userRoles UserRole[]

  // One-to-one profiles (FK lives on the profile side)
  managerProfile ManagerProfile?
  agent          Agent?

  // ClientUser membership (one user can belong to multiple clients)
  clientMemberships ClientUser[]

  // Financial authorisation
  creditNotesRequested    CreditNote[]     @relation("CreditNoteRequester")
  creditNotesApproved     CreditNote[]     @relation("CreditNoteApprover")
  paymentRequestsMade     PaymentRequest[] @relation("PaymentRequestRequester")
  paymentRequestsApproved PaymentRequest[] @relation("PaymentRequestApprover")

  // Supporting
  notifications  Notification[]
  apiCredentials ApiCredential[]
  auditLogs      AuditLog[]      @relation("AuditLogPerformedBy")

  @@index([organizationId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ============================================================
// BUSINESS PROFILES
// ============================================================

model ManagerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  agents Agent[]

  @@index([organizationId])
}

model Agent {
  id               String   @id @default(uuid())
  userId           String   @unique
  managerProfileId String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  managerProfile ManagerProfile? @relation(fields: [managerProfileId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])

  // Downstream
  clients             Client[]
  activeAssignments   ActiveAssignment[]
  assignmentHistories AssignmentHistory[]
  inboundMessages     InboundMessage[]    @relation("AgentInboundMessages")
  cdrs                Cdr[]               @relation("AgentCdrs")
  billingEvents       BillingEvent[]      @relation("AgentBillingEvents")
  wallet              Wallet?             @relation("AgentWallet")

  @@index([managerProfileId])
  @@index([organizationId])
}

model Client {
  id             String   @id @default(uuid())
  name           String
  agentId        String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent        Agent?       @relation(fields: [agentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  clientUsers         ClientUser[]
  activeAssignments   ActiveAssignment[]
  assignmentHistories AssignmentHistory[]
  inboundMessages     InboundMessage[]    @relation("ClientInboundMessages")
  cdrs                Cdr[]               @relation("ClientCdrs")
  billingEvents       BillingEvent[]      @relation("ClientBillingEvents")
  rates               Rate[]
  wallet              Wallet?             @relation("ClientWallet")

  @@index([agentId])
  @@index([organizationId])
}

// A user may be a member of multiple clients; @@unique prevents duplicate membership rows.
// NOTE: userId is NOT globally @unique here — that would restrict a user to one client.
model ClientUser {
  id       String @id @default(uuid())
  clientId String
  userId   String

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

// ============================================================
// PROVIDER LAYER
// ============================================================

model Provider {
  id             String         @id @default(uuid())
  name           String
  status         ProviderStatus @default(ACTIVE)
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  connections     ProviderConnection[]
  ranges          Range[]
  numbers         Number[]
  rates           Rate[]
  inboundMessages InboundMessage[]     @relation("ProviderInboundMessages")
  cdrs            Cdr[]                @relation("ProviderCdrs")
  billingEvents   BillingEvent[]       @relation("ProviderBillingEvents")
  wallet          Wallet?              @relation("ProviderWallet")

  @@index([organizationId])
  @@index([status])
}

model ProviderConnection {
  id              String                 @id @default(uuid())
  providerId      String
  connectionType  ProviderConnectionType
  environment     String
  status          String
  priority        Int
  // Structured config (HTTP headers, SMPP params, etc.) — never plaintext secrets
  protocolConfig  Json?
  credentialRefId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  provider            Provider             @relation(fields: [providerId], references: [id])
  credentialReference CredentialReference? @relation("CredentialRefConnections", fields: [credentialRefId], references: [id])

  @@index([providerId])
  @@index([status])
}

// Secure encrypted credential record — no plaintext secrets stored.
model CredentialReference {
  id         String    @id @default(uuid())
  label      String?
  // Encrypted payload (e.g., envelope-encrypted by KMS)
  ciphertext String?
  keyVersion String?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  connections ProviderConnection[] @relation("CredentialRefConnections")
}

// ============================================================
// GEO / INVENTORY
// ============================================================

// Country is a global lookup — no organizationId
model Country {
  id      String @id @default(uuid())
  isoCode String @unique
  name    String

  operators Operator[]
  ranges    Range[]
  numbers   Number[]
  rates     Rate[]
}

model Operator {
  id        String @id @default(uuid())
  name      String
  countryId String

  country Country @relation(fields: [countryId], references: [id])

  ranges  Range[]
  numbers Number[]
  rates   Rate[]

  @@index([countryId])
}

model Range {
  id              String   @id @default(uuid())
  providerId      String
  providerRangeId String?
  countryId       String
  operatorId      String?
  organizationId  String
  startE164       String
  endE164         String
  startNum        BigInt
  endNum          BigInt
  status          String
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  operator     Operator?    @relation(fields: [operatorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  numbers Number[]
  rates   Rate[]

  @@index([countryId])
  @@index([operatorId])
  @@index([status])
  @@index([organizationId])
}

model Number {
  id               String   @id @default(uuid())
  e164             String   @unique
  providerId       String
  countryId        String
  operatorId       String?
  rangeId          String?
  providerNumberId String?
  organizationId   String
  status           String
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  operator     Operator?    @relation(fields: [operatorId], references: [id])
  range        Range?       @relation(fields: [rangeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  activeAssignment    ActiveAssignment?
  assignmentHistories AssignmentHistory[]
  inboundMessages     InboundMessage[]
  cdrs                Cdr[]               @relation("NumberCdrs")
  billingEvents       BillingEvent[]      @relation("NumberBillingEvents")

  @@index([countryId])
  @@index([operatorId])
  @@index([rangeId])
  @@index([status])
  @@index([organizationId])
}

// ============================================================
// ASSIGNMENT
// ============================================================

model ActiveAssignment {
  id             String   @id @default(uuid())
  numberId       String   @unique
  clientId       String
  agentId        String?
  organizationId String
  assignedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  number       Number       @relation(fields: [numberId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  agent        Agent?       @relation(fields: [agentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  inboundMessages InboundMessage[] @relation("AssignmentInboundMessages")

  @@index([clientId])
  @@index([agentId])
  @@index([organizationId])
}

model AssignmentHistory {
  id             String    @id @default(uuid())
  numberId       String
  clientId       String
  agentId        String?
  organizationId String
  assignedAt     DateTime
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  number       Number       @relation(fields: [numberId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  agent        Agent?       @relation(fields: [agentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([numberId])
  @@index([clientId])
  @@index([agentId])
  @@index([organizationId])
  @@index([assignedAt])
}

// ============================================================
// MESSAGING
// ============================================================

model InboundMessage {
  id                 String        @id @default(uuid())
  organizationId     String
  providerId         String
  providerMessageId  String?
  numberId           String
  assignmentId       String?
  clientId           String?
  agentId            String?
  fromNumber         String
  toNumber           String
  body               String?
  receivedAt         DateTime
  providerReceivedAt DateTime?
  processedAt        DateTime?
  failedAt           DateTime?
  failureReason      String?
  status             InboundStatus @default(RECEIVED)
  billingStatus      BillingStatus @default(PENDING)
  metadata           Json?
  createdAt          DateTime      @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  provider     Provider          @relation("ProviderInboundMessages", fields: [providerId], references: [id])
  number       Number            @relation(fields: [numberId], references: [id])
  assignment   ActiveAssignment? @relation("AssignmentInboundMessages", fields: [assignmentId], references: [id])
  client       Client?           @relation("ClientInboundMessages", fields: [clientId], references: [id])
  agent        Agent?            @relation("AgentInboundMessages", fields: [agentId], references: [id])

  billingEvents BillingEvent[]
  cdrs          Cdr[]

  // Provider-scoped uniqueness — nullable providerMessageId handled at DB level for partial index
  @@unique([providerId, providerMessageId])
  @@index([organizationId])
  @@index([providerId])
  @@index([numberId])
  @@index([clientId])
  @@index([status])
  @@index([billingStatus])
  @@index([receivedAt])
}

// CDR: immutable historical/financial snapshot.
// billingEventId @unique enforces at-most-one CDR per BillingEvent.
model Cdr {
  id                        String   @id @default(uuid())
  organizationId            String
  inboundMessageId          String?
  providerId                String
  numberId                  String
  clientId                  String?
  agentId                   String?
  billingEventId            String?  @unique
  providerCostMicrounits    BigInt
  clientChargeMicrounits    BigInt
  agentCommissionMicrounits BigInt?
  platformProfitMicrounits  BigInt?
  currency                  String
  createdAt                 DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  inboundMessage InboundMessage? @relation(fields: [inboundMessageId], references: [id])
  provider       Provider        @relation("ProviderCdrs", fields: [providerId], references: [id])
  number         Number          @relation("NumberCdrs", fields: [numberId], references: [id])
  client         Client?         @relation("ClientCdrs", fields: [clientId], references: [id])
  agent          Agent?          @relation("AgentCdrs", fields: [agentId], references: [id])
  billingEvent   BillingEvent?   @relation("CdrBillingEvent", fields: [billingEventId], references: [id])

  @@index([organizationId])
  @@index([providerId])
  @@index([numberId])
  @@index([clientId])
  @@index([createdAt])
}

// ============================================================
// BILLING EVENT
// ============================================================

// One InboundMessage may produce multiple BillingEvents (no @unique on inboundMessageId).
// One BillingEvent has at most one CDR (enforced by Cdr.billingEventId @unique).
model BillingEvent {
  id                        String        @id @default(uuid())
  organizationId            String
  inboundMessageId          String
  providerId                String
  numberId                  String
  clientId                  String?
  agentId                   String?
  rateId                    String?
  providerCostMicrounits    BigInt
  clientChargeMicrounits    BigInt
  agentCommissionMicrounits BigInt?
  platformMarginMicrounits  BigInt?
  currency                  String
  status                    BillingStatus @default(PENDING)
  createdAt                 DateTime      @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  inboundMessage InboundMessage @relation(fields: [inboundMessageId], references: [id])
  provider       Provider       @relation("ProviderBillingEvents", fields: [providerId], references: [id])
  number         Number         @relation("NumberBillingEvents", fields: [numberId], references: [id])
  client         Client?        @relation("ClientBillingEvents", fields: [clientId], references: [id])
  agent          Agent?         @relation("AgentBillingEvents", fields: [agentId], references: [id])
  rate           Rate?          @relation(fields: [rateId], references: [id])

  ledgerEntries LedgerEntry[]
  cdr           Cdr?          @relation("CdrBillingEvent")

  @@index([organizationId])
  @@index([inboundMessageId])
  @@index([providerId])
  @@index([numberId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// RATE
// ============================================================

model Rate {
  id               String    @id @default(uuid())
  organizationId   String
  providerId       String?
  countryId        String?
  operatorId       String?
  rangeId          String?
  clientId         String?
  type             RateType
  amountMicrounits BigInt
  currency         String
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  priority         Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  provider     Provider?    @relation(fields: [providerId], references: [id])
  country      Country?     @relation(fields: [countryId], references: [id])
  operator     Operator?    @relation(fields: [operatorId], references: [id])
  range        Range?       @relation(fields: [rangeId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  billingEvents BillingEvent[]

  @@index([organizationId])
  @@index([providerId])
  @@index([countryId])
  @@index([operatorId])
  @@index([isActive])
  @@index([effectiveFrom])
}

// ============================================================
// FINANCIAL — WALLET
// NOTE: Exactly-one-owner rule is enforced via a PostgreSQL CHECK constraint
//       added during migration — not expressible in Prisma schema alone.
//       Approved owners: Client, Agent, Provider, or Platform (isPlatform=true).
// ============================================================

model Wallet {
  id                String   @id @default(uuid())
  organizationId    String
  clientId          String?  @unique
  agentId           String?  @unique
  providerId        String?  @unique
  isPlatform        Boolean  @default(false)
  balanceMicrounits BigInt   @default(0)
  currency          String   @default("USD")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation("ClientWallet", fields: [clientId], references: [id])
  agent        Agent?       @relation("AgentWallet", fields: [agentId], references: [id])
  provider     Provider?    @relation("ProviderWallet", fields: [providerId], references: [id])

  ledgerEntries       LedgerEntry[]
  billingTransactions BillingTransaction[]
  creditNotes         CreditNote[]
  paymentRequests     PaymentRequest[]

  @@index([organizationId])
}

model LedgerEntry {
  id                   String           @id @default(uuid())
  organizationId       String
  walletId             String
  amountMicrounits     BigInt
  currency             String
  type                 LedgerEntryType
  sourceType           LedgerSourceType
  sourceId             String?
  billingTransactionId String?
  billingEventId       String?
  metadata             Json?
  createdAt            DateTime         @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  wallet             Wallet              @relation(fields: [walletId], references: [id])
  billingTransaction BillingTransaction? @relation(fields: [billingTransactionId], references: [id])
  billingEvent       BillingEvent?       @relation(fields: [billingEventId], references: [id])

  @@index([walletId])
  @@index([billingEventId])
  @@index([createdAt])
  @@index([organizationId])
}

model BillingTransaction {
  id               String   @id @default(uuid())
  organizationId   String
  walletId         String
  amountMicrounits BigInt
  currency         String
  status           String
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  wallet        Wallet        @relation(fields: [walletId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@index([walletId])
  @@index([status])
}

model CreditNote {
  id               String   @id @default(uuid())
  organizationId   String
  walletId         String
  requesterId      String
  approverId       String?
  amountMicrounits BigInt
  currency         String
  status           String
  reason           String?
  reference        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  wallet       Wallet       @relation(fields: [walletId], references: [id])
  requester    User         @relation("CreditNoteRequester", fields: [requesterId], references: [id])
  approver     User?        @relation("CreditNoteApprover", fields: [approverId], references: [id])

  @@index([organizationId])
  @@index([walletId])
  @@index([requesterId])
}

model PaymentRequest {
  id               String   @id @default(uuid())
  organizationId   String
  walletId         String
  requesterId      String
  approverId       String?
  amountMicrounits BigInt
  currency         String
  status           String
  reason           String?
  reference        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  wallet       Wallet       @relation(fields: [walletId], references: [id])
  requester    User         @relation("PaymentRequestRequester", fields: [requesterId], references: [id])
  approver     User?        @relation("PaymentRequestApprover", fields: [approverId], references: [id])

  @@index([organizationId])
  @@index([walletId])
  @@index([requesterId])
}

// ============================================================
// SUPPORTING
// ============================================================

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String?
  type           NotificationType @default(INFO)
  title          String
  body           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model ApiCredential {
  id             String    @id @default(uuid())
  organizationId String
  ownerUserId    String?
  hashedToken    String
  scopes         String[]
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  ownerUser    User?        @relation(fields: [ownerUserId], references: [id])

  apiRequestLogs ApiRequestLog[]

  @@index([organizationId])
  @@index([ownerUserId])
}

model ApiRequestLog {
  id              String   @id @default(uuid())
  organizationId  String
  apiCredentialId String?
  requestId       String?
  method          String
  endpoint        String
  statusCode      Int
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  apiCredential ApiCredential? @relation(fields: [apiCredentialId], references: [id])

  @@index([organizationId])
  @@index([apiCredentialId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  performedById  String?
  entityName     String
  entityId       String
  action         String
  result         String
  ipAddress      String?
  userAgent      String?
  changes        Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  performedBy  User?        @relation("AuditLogPerformedBy", fields: [performedById], references: [id])

  @@index([organizationId])
  @@index([performedById])
  @@index([entityName, entityId])
  @@index([createdAt])
}
